# {{ ansible_managed }}
# Retention and disk-space policy for the audit daemon.

log_file = /var/log/audit/audit.log
log_format = ENRICHED
log_group = adm
flush = INCREMENTAL_ASYNC
freq = 50

max_log_file = {{ baseline_auditd_max_log_file }}
num_logs = {{ baseline_auditd_num_logs }}
max_log_file_action = {{ baseline_auditd_max_log_file_action }}

space_left = 128
space_left_action = {{ baseline_auditd_space_left_action }}
admin_space_left = 64
admin_space_left_action = {{ baseline_auditd_admin_space_left_action }}
disk_full_action = SUSPEND
disk_error_action = SUSPEND

name_format = HOSTNAME
local_events = yes
write_logs = yes
