#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}
# Included from every TLS-enabled server block.

ssl_protocols {{ nginx_ssl_protocols | join(' ') }};
ssl_ciphers {{ nginx_ssl_ciphers | join(':') }};
# With TLS 1.3 and an AEAD-only 1.2 list the client's preference order is the
# better one; forcing the server order only pins clients to older suites.
ssl_prefer_server_ciphers {{ 'on' if nginx_ssl_prefer_server_ciphers else 'off' }};
ssl_ecdh_curve {{ nginx_ssl_ecdh_curve }};

ssl_session_cache {{ nginx_ssl_session_cache }};
ssl_session_timeout {{ nginx_ssl_session_timeout }};
# Session tickets without rotation break forward secrecy; nginx has no ticket
# key rotation of its own, so they stay off.
ssl_session_tickets {{ 'on' if nginx_ssl_session_tickets else 'off' }};

{% if nginx_ssl_dhparam | length > 0 %}
ssl_dhparam {{ nginx_ssl_dhparam }};
{% endif %}
{% if nginx_ssl_stapling %}
ssl_stapling on;
ssl_stapling_verify on;
resolver {{ nginx_resolver }} valid=300s;
resolver_timeout {{ nginx_resolver_timeout }};
{% endif %}
