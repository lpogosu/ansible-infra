[Unit]
Description=Reclaim disk space used by unreferenced Docker objects
Documentation=https://docs.docker.com/engine/reference/commandline/system_prune/
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker system prune --all --force --filter "until={{ docker_host_prune_until }}"{{ ' --volumes' if docker_host_prune_volumes else '' }}
{% if docker_host_prune_build_cache %}
ExecStart=/usr/bin/docker builder prune --all --force --filter "until={{ docker_host_prune_until }}"
{% endif %}
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
